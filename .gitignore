# ============================================================
# Vitis HLS 2021.1 gitignore - generated with Claude
# ============================================================

# --- Project-level generated logs and journals ---
# Vivado/HLS always dumps these during any run; purely transient
*.log
*.jou
vivado_*.str
vitis_hls.pb

# --- Internal autopilot working directory ---
# HLS's internal scheduler/binder state; fully regenerated on csynth
**/.autopilot/

# --- C Simulation build artifacts ---
# Compiled binaries and object files from csim_design
solution*/csim/build/

# --- Generated RTL (synthesis output) ---
# Produced by csynth_design; you want to regenerate these, not track them.
# If you want to snapshot RTL for a release, do it explicitly.
solution*/syn/verilog/
solution*/syn/vhdl/
solution*/syn/systemc/

# --- Co-simulation and implementation outputs ---
solution*/sim/
solution*/impl/

# --- Exported IP catalog ---
# Re-exportable from the project at any time
solution*/export/
solution*/impl/ip/

# --- Xilinx temporary directories ---
.Xil/
.nfs*
*.tmp

# Additional Vitis HLS files
.apc/
.vitis_hls_log_all.xml
.cproject

# Custom
output.txt